# Copy this file to .env and fill in the values.   (cp .env.example .env)

NODE_ENV=production
PORT=4000
# Public address of this API — used for photo links. No trailing slash.
PUBLIC_URL=https://api.ashharrowater.com

# ---- MySQL (from Hostinger → Databases → MySQL Databases) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Security ----
# Long random text. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Web origins allowed to call the API (Super Admin web app, website). Comma separated.
CORS_ORIGINS=https://ashharrowater.com,https://www.ashharrowater.com

# ---- First Owner login, created by `npm run db:migrate` when no admin exists. Remove the password afterwards. ----
ADMIN_NAME=Owner
ADMIN_MOBILE=
ADMIN_PASSWORD=

# ---- Company (first run only — edit later in the admin panel) ----
COMPANY_NAME=Ashhar RO Water
COMPANY_NAME_HINDI=अशहर
COMPANY_PHONE=
COMPANY_WHATSAPP=
COMPANY_ADDRESS=

# ---- SMS for customer OTP and reminders ----
# console = only print in the log (testing). http = call your SMS company's URL.
SMS_PROVIDER=console
# {mobile} and {message} are filled in automatically. Example:
# SMS_URL_TEMPLATE=https://sms.example.com/api/send?apikey=YOUR_KEY&to={mobile}&text={message}
SMS_URL_TEMPLATE=
SMS_HTTP_METHOD=GET

# Numbers that always accept a fixed OTP without SMS, e.g. for the Google Play reviewer. mobile:otp,mobile:otp
OTP_TEST_NUMBERS=
# TESTING ONLY: every customer logs in with this 4-digit OTP and no SMS is sent. Remove before launch.
TEST_OTP=1234

# ---- Razorpay online payments (dashboard.razorpay.com → Account & Settings → API Keys / Webhooks) ----
# Leave empty to hide "Pay online" in the app. Test keys start with rzp_test_. PUBLIC_URL (above) must be set too.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to add in Razorpay: https://api.ashharrowater.com/v1/public/razorpay/webhook  (event: payment_link.paid)
RAZORPAY_WEBHOOK_SECRET=

# ---- Push notifications (Expo push service) ----
PUSH_ENABLED=true
# Only if "Enhanced push security" is on in your Expo account
EXPO_ACCESS_TOKEN=

# ---- Files & jobs ----
APP_TIMEZONE=Asia/Kolkata
UPLOAD_DIR=uploads
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
JOBS_ENABLED=true

# ---- Live tracking ----
# Days of delivery-boy paths kept for the admin's "Route taken" view (older days are deleted automatically)
LOCATION_KEEP_DAYS=30
